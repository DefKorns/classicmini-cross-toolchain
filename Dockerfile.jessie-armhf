#
# Shared ARM/armhf cross-compile toolchain for NES/SNES Classic hmods. Each
# consuming project keeps its own Makefile.docker; this image only provides
# the compiler, SDL2/libpng/SDL2_ttf/freetype/ALSA, upx, and git/rsync (for
# Makefile.docker targets that tag versions or package the .hmod in-container).
# Every console library is built from public source; nothing is copied off a
# console: `docker build -f toolchain/Dockerfile.jessie-armhf -t <image> toolchain/`.
#
# Target: GLIBC <= 2.23, GLIBCXX <= 3.4.20 (the console's runtime ceiling).
# Modern host toolchains link against newer symbols the console can't
# satisfy. Debian never shipped an armhf cross-compiler before Stretch (too
# new), so this uses the prebuilt Linaro GCC 4.9.4/glibc 2.21 toolchain,
# cross-built for Cortex-A7, via crosstool-NG:
# https://github.com/Christopher83/arm-cortex_a7-linux-gnueabihf-linaro_4.9
# Jessie itself is just the base userland (make, pkg-config).

# The console's SDL2 is Nintendo's 2.0.4 fork (Mali video driver), published
# only in their OSS release; fetched from a pinned extracted mirror of it.
# Jessie's git is too old for partial clones, hence the separate stage.
FROM debian:bookworm-slim AS oss
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/*
ARG OSS_COMMIT=c62f184fcf539f7d47ba1ce6352574e768cf880b
ARG SDL2_PKG=ext-sdl2-6bd764a32987c8117f4c85e319b799829eedadec
RUN git clone --filter=blob:none --no-checkout https://github.com/DefKorns/snes-classic-oss.git /oss \
    && cd /oss \
    && git sparse-checkout set --no-cone "/${SDL2_PKG}/" \
    && git checkout "$OSS_COMMIT" \
    && mv "/oss/${SDL2_PKG}" /sdl2

FROM debian:jessie

# Jessie is archived; point apt at archive.debian.org and skip Valid-Until
# checks. debian-security is needed alongside plain jessie/main: this base
# image ships perl-base 5.20.2-3+deb8u12, but jessie/main's own archived
# snapshot only has a perl built against the older +deb8u11 - without the
# security suite, apt refuses to install perl (and anything depending on
# it, like git) since it won't downgrade the already-installed perl-base.
RUN echo 'deb http://archive.debian.org/debian/ jessie main' > /etc/apt/sources.list \
    && echo 'deb http://archive.debian.org/debian-security/ jessie/updates main' >> /etc/apt/sources.list \
    && echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99no-check-valid-until \
    && echo 'Acquire::AllowInsecureRepositories "true";' >> /etc/apt/apt.conf.d/99no-check-valid-until

# gcc/libc6-dev: host compiler for build-time helpers (freetype's apinames).
RUN apt-get update -o Acquire::AllowInsecureRepositories=true \
    && apt-get install -y --no-install-recommends --allow-unauthenticated \
    bzip2 \
    ca-certificates \
    cmake \
    curl \
    gcc \
    git \
    libc6-dev \
    make \
    patch \
    pkg-config \
    rsync \
    xz-utils

# zlib from Jessie; dpkg-deb -x skips dependency resolution.
RUN dpkg --add-architecture armhf \
    && apt-get update -o Acquire::AllowInsecureRepositories=true \
    && mkdir -p /tmp/debs && cd /tmp/debs \
    && apt-get download -o Acquire::AllowInsecureRepositories=true -o APT::Get::AllowUnauthenticated=true \
    zlib1g-dev:armhf zlib1g:armhf \
    && for f in *.deb; do dpkg-deb -x "$f" /; done \
    && cd / && rm -rf /tmp/debs /var/lib/apt/lists/*

# From Stretch: EGL/GLES2/udev headers for SDL2's Mali build (headers only,
# kept out of the sysroot; host-arch packages, since some armhf -dev ones
# are gone from the archive).
RUN echo 'deb http://archive.debian.org/debian/ stretch main' > /etc/apt/sources.list \
    && apt-get update -o Acquire::AllowInsecureRepositories=true \
    && mkdir -p /tmp/debs/headers && cd /tmp/debs \
    && (cd headers && apt-get download -o Acquire::AllowInsecureRepositories=true -o APT::Get::AllowUnauthenticated=true \
    libegl1-mesa-dev libgles2-mesa-dev mesa-common-dev libudev-dev) \
    && mkdir -p /opt/sdl2-headers \
    && for f in headers/*.deb; do dpkg-deb -x "$f" /tmp/debs/x; done \
    && cp -r /tmp/debs/x/usr/include/EGL /tmp/debs/x/usr/include/GLES2 /tmp/debs/x/usr/include/KHR \
    /tmp/debs/x/usr/include/libudev.h /opt/sdl2-headers/ \
    && cd / && rm -rf /tmp/debs /var/lib/apt/lists/* \
    && echo 'deb http://archive.debian.org/debian/ jessie main' > /etc/apt/sources.list

# Mali's fbdev window type, as SDL2's Mali driver uses it.
RUN printf '%s\n' \
    '#ifndef FBDEV_WINDOW_H' '#define FBDEV_WINDOW_H' \
    'typedef struct fbdev_window { unsigned short width; unsigned short height; } fbdev_window;' \
    '#endif' > /opt/sdl2-headers/fbdev_window.h

# arch-independent headers the cross-compiler doesn't search by default
# (only -I/usr/include/arm-linux-gnueabihf).
RUN ln -s /usr/include/zlib.h /usr/include/arm-linux-gnueabihf/zlib.h \
    && ln -s /usr/include/freetype2 /usr/include/arm-linux-gnueabihf/freetype2 \
    && ln -s /usr/include/alsa /usr/include/arm-linux-gnueabihf/alsa

# prebuilt Cortex-A7 GCC 4.9.4/glibc 2.21 toolchain, exposed under the
# arm-linux-gnueabihf- prefix Makefiles expect. Pinned to a specific commit
# of DefKorns' own fork, not upstream's master: the original
# (Christopher83/arm-cortex_a7-linux-gnueabihf-linaro_4.9) has no LICENSE
# file, no tags, and only 6 commits on master - too fragile a dependency to
# pull from live and unpinned.
RUN curl -fL --retry 3 -o /tmp/toolchain.tar.gz \
    https://codeload.github.com/DefKorns/arm-cortex_a7-linux-gnueabihf-linaro_4.9/tar.gz/e356b8ff3017c0bb0627ef6ebb8750f774d216a8 \
    && mkdir -p /opt/toolchain \
    && tar -xzf /tmp/toolchain.tar.gz -C /opt/toolchain --strip-components=1 \
    && rm -f /tmp/toolchain.tar.gz \
    && for f in /opt/toolchain/bin/arm-cortex_a7-linux-gnueabihf-*; do \
    suffix=$(basename "$f" | sed 's/^arm-cortex_a7-linux-gnueabihf-//'); \
    ln -sf "$f" "/opt/toolchain/bin/arm-linux-gnueabihf-$suffix"; \
    done

ENV PATH="/opt/toolchain/bin:${PATH}"

# Console library versions, built for linking against (and shipping, for
# freetype/SDL2_ttf, which the console lacks). Installed via DESTDIR so only
# libs/headers/.pc land in the sysroot, never ARM binaries in /usr/bin.
ENV CROSS_LIBDIR=/usr/lib/arm-linux-gnueabihf \
    PKG_CONFIG_LIBDIR=/usr/lib/arm-linux-gnueabihf/pkgconfig
COPY <<'EOF' /usr/local/bin/cross-autotools
#!/bin/sh
# [MAKE_ARGS=...] cross-autotools <url> <sha256> [configure args...]
set -e
url=$1 sha=$2; shift 2
cd /tmp && rm -rf build stage && mkdir build
curl -fL --retry 3 -o src.tar "$url"
echo "$sha  src.tar" | sha256sum -c -
tar -xf src.tar -C build --strip-components=1
cd build
CC=arm-linux-gnueabihf-gcc \
CPPFLAGS="-I/usr/include/arm-linux-gnueabihf" \
LDFLAGS="-L$CROSS_LIBDIR -Wl,--allow-shlib-undefined" \
./configure --host=arm-linux-gnueabihf --prefix=/usr --libdir="$CROSS_LIBDIR" \
    --disable-static "$@"
make -j"$(nproc)" $MAKE_ARGS
make install DESTDIR=/tmp/stage $MAKE_ARGS
find /tmp/stage -name '*.so*' -type f -exec arm-linux-gnueabihf-strip --strip-unneeded {} +
cp -a /tmp/stage/usr/include/. /usr/include/
cp -a /tmp/stage$CROSS_LIBDIR/. $CROSS_LIBDIR/
find $CROSS_LIBDIR -name '*.la' -delete
# *-config helpers are shell scripts, safe to run on the host
for f in /tmp/stage/usr/bin/*-config; do
    [ -f "$f" ] && head -c2 "$f" | grep -q '#!' && cp "$f" /usr/local/bin/
done
cd / && rm -rf /tmp/build /tmp/stage /tmp/src.tar
EOF
RUN chmod +x /usr/local/bin/cross-autotools

# Versions are the oldest across both consoles (NES Classic: alsa-lib 1.0.29,
# libpng 1.6.20), so nothing links against a symbol one of them lacks.
# alsa-lib unversioned, like the console's.
RUN cross-autotools https://www.alsa-project.org/files/pub/lib/alsa-lib-1.0.29.tar.bz2 \
    73043c35eb9636be0f4af6a240235c213f12a25feb1f04aeeac8cb7e30fcbdd0 \
    --disable-python --with-configdir=/usr/share/alsa --without-versioned

RUN cross-autotools https://download.sourceforge.net/libpng/libpng-1.6.20.tar.xz \
    55c5959e9f3484d96141a3226c53bc9da42a4845e70879d3e1d6e94833d1918b

# no zlib/bzip2/png/harfbuzz, like the copy the console hmods ship
RUN cross-autotools https://download.savannah.gnu.org/releases/freetype/freetype-2.8.1.tar.bz2 \
    e5435f02e02d2b87bb8e4efdcaa14b1f78c9cf3ab1ed80f94b6382fb6acc7d78 \
    --without-zlib --without-bzip2 --without-png --without-harfbuzz

# Nintendo's CMakeLists needs their in-house NerdCMakeModules, which isn't in
# the OSS release; its add_package/package_library only do packaging, so
# no-op stand-ins suffice. GPU driver stubs (empty functions generated from
# the EGL/GLES2 headers) satisfy the -lMali/-lEGL link under SDL's
# --no-undefined; the console's real ones are used at runtime. Output matches the
# console's: libSDL2.so, SONAME "libSDL2.so". Flags go through $CFLAGS: the
# CMakeLists overwrites CMAKE_C_FLAGS with it, and CMake 3.0's feature
# checks ignore linker flags, hence the -L there too.
COPY --from=oss /sdl2 /tmp/sdl2
RUN cd /tmp/sdl2/source \
    && for p in $(cat ../series); do patch -p1 < "../$p"; done \
    && mkdir -p /tmp/sdl2/nerd /tmp/sdl2/stubs \
    && printf '%s\n' 'include(GNUInstallDirs)' 'list(APPEND CMAKE_MODULE_PATH ${CMAKE_CURRENT_LIST_DIR})' \
    > /tmp/sdl2/nerd/NerdCMakeModulesConfig.cmake \
    && printf '%s\n' 'macro(add_package)' 'endmacro()' 'macro(package_library)' 'endmacro()' \
    > /tmp/sdl2/nerd/NerdPackageHelper.cmake \
    && stub() { \
    { [ -n "$2" ] && grep -h -o -E "\b$2[A-Za-z0-9_]* *\(" $3 | tr -d ' (' | sort -u | sed 's/.*/void &(void) {}/'; } \
    | arm-linux-gnueabihf-gcc -x c -shared -o "/tmp/sdl2/stubs/lib$1.so" -Wl,-soname,"lib$1.so" -; \
    } \
    && stub Mali "" "" && stub GLESv1_CM "" "" \
    && stub EGL egl /opt/sdl2-headers/EGL/egl.h \
    && stub GLESv2 gl /opt/sdl2-headers/GLES2/gl2.h \
    && mkdir -p /tmp/sdl2/pc \
    && printf 'Name: egl\nDescription: stub\nVersion: 1.4\nLibs: -L/tmp/sdl2/stubs -lEGL\n' > /tmp/sdl2/pc/egl.pc \
    && printf 'Name: glesv2\nDescription: stub\nVersion: 2.0\nLibs: -L/tmp/sdl2/stubs -lGLESv2 -lGLESv1_CM\n' > /tmp/sdl2/pc/glesv2.pc \
    && printf '%s\n' \
    'set(CMAKE_SYSTEM_NAME Linux)' 'set(CMAKE_SYSTEM_PROCESSOR arm)' \
    'set(CMAKE_C_COMPILER arm-linux-gnueabihf-gcc)' \
    'set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)' > /tmp/sdl2/toolchain.cmake \
    && mkdir build && cd build \
    && PKG_CONFIG_PATH=/tmp/sdl2/pc CFLAGS="-O2 -I/usr/include/arm-linux-gnueabihf -I/opt/sdl2-headers -include /opt/sdl2-headers/fbdev_window.h -DMESA_EGL_NO_X11_HEADERS -L$CROSS_LIBDIR -L/tmp/sdl2/stubs" \
    cmake .. -DCMAKE_TOOLCHAIN_FILE=/tmp/sdl2/toolchain.cmake -DNerdCMakeModules_DIR=/tmp/sdl2/nerd \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DLIB_SUFFIX=/arm-linux-gnueabihf \
    -DCMAKE_INSTALL_LIBDIR=lib/arm-linux-gnueabihf -DBUILD_SHARED_LIBS=ON \
    -DRPATH=OFF -DCLOCK_GETTIME=ON \
    -DVIDEO_MALI=ON -DVIDEO_OPENGLES=ON -DVIDEO_OPENGL=OFF \
    -DVIDEO_X11=OFF -DVIDEO_WAYLAND=OFF -DVIDEO_MIR=OFF -DVIDEO_RPI=OFF -DVIDEO_VIVANTE=OFF \
    -DVIDEO_DUMMY=OFF -DVIDEO_DIRECTFB=OFF \
    -DALSA=ON -DALSA_SHARED=ON -DOSS=OFF -DPULSEAUDIO=OFF -DESD=OFF -DARTS=OFF \
    -DNAS=OFF -DSNDIO=OFF -DFUSIONSOUND=OFF -DDISKAUDIO=OFF -DDUMMYAUDIO=OFF \
    -DINPUT_TSLIB=OFF \
    && make -j"$(nproc)" \
    && make install DESTDIR=/tmp/sdl2/stage \
    && cp -a /tmp/sdl2/stage/usr/include/SDL2 /usr/include/ \
    && cp /tmp/sdl2/stage/usr/lib/arm-linux-gnueabihf/pkgconfig/sdl2.pc "$PKG_CONFIG_LIBDIR/" \
    && cp "$(find . -name libSDL2.so -type f)" "$CROSS_LIBDIR/libSDL2.so" \
    && cd / && rm -rf /tmp/sdl2

# skip the showfont/glfont demos
RUN MAKE_ARGS="noinst_PROGRAMS=" cross-autotools https://www.libsdl.org/projects/SDL_ttf/release/SDL2_ttf-2.0.14.tar.gz \
    34db5e20bcf64e7071fe9ae25acaa7d72bdc4f11ab3ce59acc768ab62fe39276 \
    --disable-sdltest --without-x

# static HTTPS-only libcurl on mbedTLS for the Options Menu downloader -
# BusyBox wget can't do TLS 1.2. mbedTLS instead of OpenSSL: the linked
# downloader is 0.25 MB instead of 1 MB after upx. TLS 1.2 only, no server
# side, DTLS, PSK or legacy ciphers.
RUN curl -fL --retry 3 -o /tmp/mbedtls.tar.bz2 \
    https://github.com/Mbed-TLS/mbedtls/releases/download/mbedtls-3.6.2/mbedtls-3.6.2.tar.bz2 \
    && echo "8b54fb9bcf4d5a7078028e0520acddefb7900b3e66fec7f7175bb5b7d85ccdca  /tmp/mbedtls.tar.bz2" | sha256sum -c - \
    && mkdir -p /tmp/mbedtls && tar -xjf /tmp/mbedtls.tar.bz2 -C /tmp/mbedtls --strip-components=1 \
    && cd /tmp/mbedtls \
    && for d in SSL_PROTO_TLS1_3 SSL_TLS1_3_COMPATIBILITY_MODE SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_ENABLED \
    SSL_TLS1_3_KEY_EXCHANGE_MODE_EPHEMERAL_ENABLED SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_EPHEMERAL_ENABLED \
    SSL_EARLY_DATA SSL_PROTO_DTLS SSL_DTLS_ANTI_REPLAY SSL_DTLS_HELLO_VERIFY SSL_DTLS_CLIENT_PORT_REUSE \
    SSL_DTLS_CONNECTION_ID SSL_DTLS_SRTP SSL_SRV_C SSL_COOKIE_C SSL_CACHE_C SSL_TICKET_C NET_C TIMING_C \
    ARIA_C CAMELLIA_C DES_C CMAC_C NIST_KW_C PKCS7_C X509_CSR_PARSE_C X509_CSR_WRITE_C X509_CRT_WRITE_C \
    X509_CREATE_C PEM_WRITE_C SHA3_C RIPEMD160_C LMS_C ECJPAKE_C KEY_EXCHANGE_ECJPAKE_ENABLED \
    KEY_EXCHANGE_PSK_ENABLED KEY_EXCHANGE_DHE_PSK_ENABLED KEY_EXCHANGE_ECDHE_PSK_ENABLED \
    KEY_EXCHANGE_RSA_PSK_ENABLED KEY_EXCHANGE_RSA_ENABLED SELF_TEST DEBUG_C VERSION_FEATURES GENPRIME \
    PKCS5_C PKCS12_C ECP_DP_SECP192R1_ENABLED ECP_DP_SECP224R1_ENABLED ECP_DP_SECP192K1_ENABLED \
    ECP_DP_SECP224K1_ENABLED ECP_DP_SECP256K1_ENABLED ECP_DP_BP256R1_ENABLED ECP_DP_BP384R1_ENABLED \
    ECP_DP_BP512R1_ENABLED ECP_DP_CURVE448_ENABLED PSA_CRYPTO_C PSA_CRYPTO_STORAGE_C PSA_ITS_FILE_C; do \
    sed -i "s|^#define MBEDTLS_$d\$|//&|; s|^#define MBEDTLS_$d |//&|" include/mbedtls/mbedtls_config.h; done \
    && make -C library -j"$(nproc)" GEN_FILES= CC=arm-linux-gnueabihf-gcc AR=arm-linux-gnueabihf-ar \
    CFLAGS="-std=gnu99 -Os -ffunction-sections -fdata-sections" libmbedcrypto.a libmbedx509.a libmbedtls.a \
    && mkdir -p /opt/mbedtls/lib && cp -r include /opt/mbedtls/ && cp library/*.a /opt/mbedtls/lib/ \
    && cd / && rm -rf /tmp/mbedtls /tmp/mbedtls.tar.bz2

# 8.11's TLS 1.3 ticket call isn't guarded by MBEDTLS_SSL_PROTO_TLS1_3
RUN curl -fL --retry 3 -o /tmp/curl-src.tar.xz https://curl.se/download/curl-8.11.1.tar.xz \
    && echo "c7ca7db48b0909743eaef34250da02c19bc61d4f1dcedd6603f109409536ab56  /tmp/curl-src.tar.xz" | sha256sum -c - \
    && mkdir -p /tmp/curl-src && tar -xJf /tmp/curl-src.tar.xz -C /tmp/curl-src --strip-components=1 \
    && cd /tmp/curl-src \
    && sed -i 's|^#ifdef MBEDTLS_SSL_TLS1_3_SIGNAL_NEW_SESSION_TICKETS_ENABLED|#if defined(MBEDTLS_SSL_TLS1_3_SIGNAL_NEW_SESSION_TICKETS_ENABLED) \&\& defined(MBEDTLS_SSL_PROTO_TLS1_3)|' \
    lib/vtls/mbedtls.c \
    && CC=arm-linux-gnueabihf-gcc CFLAGS="-Os -ffunction-sections -fdata-sections" LIBS="-lpthread" \
    ./configure --host=arm-linux-gnueabihf --prefix=/opt/curl-static \
    --disable-shared --enable-static --with-mbedtls=/opt/mbedtls --without-zlib \
    --disable-ftp --disable-file --disable-smb --disable-ldap --disable-ldaps --disable-rtsp \
    --disable-dict --disable-telnet --disable-tftp --disable-pop3 --disable-imap --disable-smtp \
    --disable-gopher --disable-mqtt --disable-manual --disable-ntlm --disable-cookies \
    --disable-alt-svc --disable-hsts --disable-doh --disable-mime --disable-netrc \
    --disable-progress-meter --disable-verbose --disable-proxy --disable-kerberos-auth \
    --disable-negotiate-auth --disable-aws --disable-unix-sockets --disable-headers-api \
    --disable-bindlocal --disable-dateparse --disable-ipfs --disable-websockets \
    --without-librtmp --without-libssh2 --without-libssh --without-nghttp2 --without-libidn2 \
    --without-libpsl --without-brotli --without-zstd --without-gssapi \
    && make -j"$(nproc)" \
    && make install \
    && cd / && rm -rf /tmp/curl-src /tmp/curl-src.tar.xz

# static upx build (Jessie's own package is too old for modern binutils
# output). Pinned to 4.2.x, not 5.x: 5.0 needs memfd_create() for its ELF
# stub, which the console's kernel doesn't have.
RUN curl -fL --retry 3 -o /tmp/upx.tar.xz \
    https://github.com/upx/upx/releases/download/v4.2.4/upx-4.2.4-amd64_linux.tar.xz \
    && mkdir -p /tmp/upx && tar -xJf /tmp/upx.tar.xz -C /tmp/upx --strip-components=1 \
    && install -m755 /tmp/upx/upx /usr/local/bin/upx \
    && rm -rf /tmp/upx.tar.xz /tmp/upx

WORKDIR /src
CMD ["make", "CROSS_PREFIX=arm-linux-gnueabihf-"]
