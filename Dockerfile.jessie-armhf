# Shared ARM/armhf cross-compile toolchain for NES/SNES Classic hmods. Each
# consuming project keeps its own Makefile.docker; this image only provides
# the compiler, SDL2/libpng/SDL2_ttf/freetype/ALSA, and upx. Build context
# must be this repo's own root (so vendor/ resolves):
# `docker build -f toolchain/Dockerfile.jessie-armhf -t <image> toolchain/`.
#
# Target: GLIBC <= 2.23, GLIBCXX <= 3.4.20 (the console's runtime ceiling).
# Modern host toolchains link against newer symbols the console can't
# satisfy. Debian never shipped an armhf cross-compiler before Stretch (too
# new), so this uses the prebuilt Linaro GCC 4.9.4/glibc 2.21 toolchain,
# cross-built for Cortex-A7, via crosstool-NG:
# https://github.com/Christopher83/arm-cortex_a7-linux-gnueabihf-linaro_4.9
# Jessie itself is just the base userland (make, pkg-config).
FROM debian:jessie

# Jessie is archived; point apt at archive.debian.org and skip Valid-Until checks.
RUN echo 'deb http://archive.debian.org/debian/ jessie main' > /etc/apt/sources.list \
    && echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99no-check-valid-until \
    && echo 'Acquire::AllowInsecureRepositories "true";' >> /etc/apt/apt.conf.d/99no-check-valid-until

RUN apt-get update -o Acquire::AllowInsecureRepositories=true \
    && apt-get install -y --no-install-recommends --allow-unauthenticated \
    ca-certificates \
    curl \
    make \
    pkg-config \
    xz-utils

# full libsdl2-dev pulls in Wayland/X11/PulseAudio/Mesa, none of which
# resolve cleanly against the frozen archive; download just the needed .debs
# and unpack directly (dpkg-deb -x skips dependency resolution).
RUN dpkg --add-architecture armhf \
    && apt-get update -o Acquire::AllowInsecureRepositories=true \
    && mkdir -p /tmp/debs && cd /tmp/debs \
    && apt-get download -o Acquire::AllowInsecureRepositories=true -o APT::Get::AllowUnauthenticated=true \
    libsdl2-dev:armhf libsdl2-2.0-0:armhf \
    zlib1g-dev:armhf zlib1g:armhf \
    && for f in *.deb; do dpkg-deb -x "$f" /; done \
    && cd / && rm -rf /tmp/debs /var/lib/apt/lists/*

# swap Debian's SDL2 (2.0.2, generic config) for the console's own build
# (2.0.4, SDL_VIDEO_DRIVER_MALI). Its libSDL2.so has SONAME "libSDL2.so" (no
# version suffix, unlike Debian's), so linking against it directly already
# produces the correct NEEDED entry. Needs vendor/sdl2-headers/ and
# vendor/lib.tar present next to this Dockerfile.
COPY vendor/sdl2-headers/ /usr/include/SDL2/

ADD vendor/lib.tar /tmp/console-libs/
RUN rm -f /usr/lib/arm-linux-gnueabihf/libSDL2-2.0.so* /usr/lib/arm-linux-gnueabihf/libSDL2.so \
    && cp /tmp/console-libs/libSDL2.so /usr/lib/arm-linux-gnueabihf/libSDL2.so \
    && rm -rf /tmp/console-libs

# libpng16/SDL2_ttf/freetype6/asound dev packages don't exist in Jessie;
# pull their headers from Stretch (stable across the relevant minor
# versions - no console-specific variant needed there). The .so files get
# swapped for the real ones below.
RUN echo 'deb http://archive.debian.org/debian/ stretch main' > /etc/apt/sources.list \
    && apt-get update -o Acquire::AllowInsecureRepositories=true \
    && mkdir -p /tmp/debs && cd /tmp/debs \
    && apt-get download -o Acquire::AllowInsecureRepositories=true -o APT::Get::AllowUnauthenticated=true \
    libpng-dev:armhf libpng16-16:armhf \
    libsdl2-ttf-dev:armhf libsdl2-ttf-2.0-0:armhf \
    libfreetype6-dev:armhf libfreetype6:armhf \
    libasound2-dev:armhf libasound2:armhf \
    && for f in *.deb; do dpkg-deb -x "$f" /; done \
    && cd / && rm -rf /tmp/debs /var/lib/apt/lists/* \
    && echo 'deb http://archive.debian.org/debian/ jessie main' > /etc/apt/sources.list

# real libpng16.so.16 extracted from the console (vendor/libpng.tar).
ADD vendor/libpng.tar /tmp/console-libs/
RUN rm -f /usr/lib/arm-linux-gnueabihf/libpng16.so* /usr/lib/arm-linux-gnueabihf/libpng.so \
    && cp /tmp/console-libs/libpng16.so.16 /usr/lib/arm-linux-gnueabihf/libpng16.so.16 \
    && ln -s libpng16.so.16 /usr/lib/arm-linux-gnueabihf/libpng16.so \
    && ln -s libpng16.so /usr/lib/arm-linux-gnueabihf/libpng.so \
    && rm -rf /tmp/console-libs

# same swap-in for SDL2_ttf/freetype/ALSA. Not currently linked by any
# binary here - vendored so a future TTF-text or audio feature doesn't need
# fresh console-library extraction.
ADD vendor/libSDL2_ttf.tar /tmp/console-libs/
RUN rm -f /usr/lib/arm-linux-gnueabihf/libSDL2_ttf*.so* \
    && cp /tmp/console-libs/libSDL2_ttf.so /usr/lib/arm-linux-gnueabihf/libSDL2_ttf.so \
    && rm -rf /tmp/console-libs

ADD vendor/libfreetype.tar /tmp/console-libs/
RUN rm -f /usr/lib/arm-linux-gnueabihf/libfreetype.so* \
    && cp /tmp/console-libs/libfreetype.so.2.8.1 /usr/lib/arm-linux-gnueabihf/libfreetype.so.2.8.1 \
    && ln -s libfreetype.so.2.8.1 /usr/lib/arm-linux-gnueabihf/libfreetype.so.2.8 \
    && ln -s libfreetype.so.2.8 /usr/lib/arm-linux-gnueabihf/libfreetype.so \
    && rm -rf /tmp/console-libs

ADD vendor/libasound.tar /tmp/console-libs/
RUN rm -f /usr/lib/arm-linux-gnueabihf/libasound.so* \
    && cp /tmp/console-libs/libasound.so.2.0.0 /usr/lib/arm-linux-gnueabihf/libasound.so.2.0.0 \
    && ln -s libasound.so.2.0.0 /usr/lib/arm-linux-gnueabihf/libasound.so.2 \
    && ln -s libasound.so.2 /usr/lib/arm-linux-gnueabihf/libasound.so \
    && rm -rf /tmp/console-libs

# zlib.h/freetype2/alsa headers land in arch-independent /usr/include, which
# the cross-compiler doesn't search by default (only -I/usr/include/arm-linux-gnueabihf).
RUN ln -s /usr/include/zlib.h /usr/include/arm-linux-gnueabihf/zlib.h \
    && ln -s /usr/include/freetype2 /usr/include/arm-linux-gnueabihf/freetype2 \
    && ln -s /usr/include/alsa /usr/include/arm-linux-gnueabihf/alsa

# prebuilt Cortex-A7 GCC 4.9.4/glibc 2.21 toolchain, exposed under the
# arm-linux-gnueabihf- prefix Makefiles expect.
RUN curl -fL --retry 3 -o /tmp/toolchain.tar.gz \
    https://codeload.github.com/Christopher83/arm-cortex_a7-linux-gnueabihf-linaro_4.9/tar.gz/refs/heads/master \
    && mkdir -p /opt/toolchain \
    && tar -xzf /tmp/toolchain.tar.gz -C /opt/toolchain --strip-components=1 \
    && rm -f /tmp/toolchain.tar.gz \
    && for f in /opt/toolchain/bin/arm-cortex_a7-linux-gnueabihf-*; do \
    suffix=$(basename "$f" | sed 's/^arm-cortex_a7-linux-gnueabihf-//'); \
    ln -sf "$f" "/opt/toolchain/bin/arm-linux-gnueabihf-$suffix"; \
    done

ENV PATH="/opt/toolchain/bin:${PATH}"

# static upx build (Jessie's own package is too old for modern binutils
# output). Pinned to 4.2.x, not 5.x: 5.0 needs memfd_create() for its ELF
# stub, which the console's kernel doesn't have.
RUN curl -fL --retry 3 -o /tmp/upx.tar.xz \
    https://github.com/upx/upx/releases/download/v4.2.4/upx-4.2.4-amd64_linux.tar.xz \
    && mkdir -p /tmp/upx && tar -xJf /tmp/upx.tar.xz -C /tmp/upx --strip-components=1 \
    && install -m755 /tmp/upx/upx /usr/local/bin/upx \
    && rm -rf /tmp/upx.tar.xz /tmp/upx

WORKDIR /src
CMD ["make", "CROSS_PREFIX=arm-linux-gnueabihf-"]
